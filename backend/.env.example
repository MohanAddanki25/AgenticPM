# Mongo
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=agentic_pm_system

# Use in-memory mock Mongo if real Mongo unreachable (great for local demo)
USE_MOCK_DB_FALLBACK=false

# Redis
REDIS_URL=http://localhost:6379/

# JWT
JWT_SECRET_KEY=change-this-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini (optional - if omitted, agents fall back to deterministic rule-based reasoning)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# CORS
FRONTEND_ORIGIN=http://localhost:5173
